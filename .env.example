POSTGRES_USER=""
POSTGRES_PASSWORD=""
POSTGRES_DB=""
POSTGRES_HOST_PORT=""

# Used by the NestJS application running directly on your machine.
DATABASE_URL=""

NODE_ENV=development
PORT=3000

# Comma-separated list of trusted frontend origins.
CORS_ORIGINS=http://localhost:5173

# Authentication. Replace every value before running the app.
JWT_SECRET=
PIN_PEPPER=
JWT_ISSUER=
JWT_AUDIENCE=

# Access-token lifetime in seconds or as a duration such as 8h.
JWT_ACCESS_TTL=8h

# Failed PIN attempts before lockout and the escalating lock durations.
LOCKOUT_THRESHOLD=5
LOCKOUT_MINUTES=5,15,60

# Login throttling per minute.
LOGIN_THROTTLE_IP_PER_MIN=10
LOGIN_THROTTLE_CODE_PER_MIN=5

# Initial store and admin created by `prisma db seed`.
SEED_STORE_NAME=
SEED_STORE_CURRENCY=
SEED_STORE_TIMEZONE=
SEED_ADMIN_CODE=
SEED_ADMIN_FIRST_NAME=Ada
SEED_ADMIN_LAST_NAME=Okafor
SEED_ADMIN_PHONE=08031234567
SEED_ADMIN_PIN=
